<!DOCTYPE html>
<html lang="en">
  <head>
    <title>GBV Support Malaysia</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Website icon (stops the favicon.ico 404 error in the console) %>
    <link rel="icon" href="/icon.png" type="image/png">

    <%# Bootstrap CSS (loaded from CDN) %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%# Loads application.js, Turbo and the Stimulus JavaScript framework %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Lab 3: quick-exit controller listens for the Esc key on every page %>
  <body class="d-flex flex-column min-vh-100"
        data-controller="quick-exit"
        data-action="keydown@window->quick-exit#key">

    <%# Emergency banner shown on every page %>
    <div class="bg-danger text-white text-center py-2 small">
      In immediate danger? Call <strong>999</strong>
    </div>

    <%# Responsive navbar %>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container">
        <%= link_to "GBV Support MY", root_path, class: "navbar-brand fw-bold" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item"><%= link_to "What Is", what_is_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Law Enforcement", law_enforcement_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Enforcer", enforcer_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Hotline", hotline_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Contact", contact_path, class: "nav-link" %></li>
            <%# Lab 3: show Admin and Log out when logged in, otherwise a Login link %>
            <% if logged_in? %>
              <li class="nav-item"><%= link_to "Admin", admin_path, class: "nav-link" %></li>
              <li class="nav-item">
                <%= button_to "Log out (#{current_user})", logout_path, method: :delete,
                              class: "nav-link btn btn-link", form_class: "d-inline" %>
              </li>
            <% else %>
              <li class="nav-item"><%= link_to "Login", login_path, class: "nav-link" %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container py-4 flex-grow-1">
      <%# Messages from the controllers (flash), shown on every page %>
      <% if flash[:error] %>
        <div class="alert alert-warning"><%= flash[:error] %></div>
      <% end %>
      <% if flash[:notice] %>
        <div class="alert alert-success"><%= flash[:notice] %></div>
      <% end %>

      <%= yield %>
    </main>

    <%# Lab 3: live Malaysia date and time, updated every second by clock_controller.js %>
    <footer class="bg-dark text-white-50 text-center py-3 small" data-controller="clock">
      ITT588 Lab Work 03 | Information website on domestic violence and GBV in Malaysia
      <div class="mt-1">
        <span data-clock-target="time">Loading Malaysia time...</span>
      </div>
    </footer>

    <%# Lab 3: Quick Exit button. Leaves the site at once if someone walks in %>
    <button type="button" class="btn btn-dark quick-exit shadow"
            data-action="quick-exit#leave"
            title="Leave this site quickly (or press Esc)">
      Quick Exit <span class="badge bg-light text-dark ms-1">Esc</span>
    </button>

    <%# Bootstrap JS (makes the mobile menu work) %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
