<%# Lab 3: Login page. The form is sent to SessionsController#create %>
<div class="row justify-content-center">
  <div class="col-12 col-md-7 col-lg-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h1 class="h3 mb-1">Admin login</h1>
        <p class="text-muted small mb-4">For the website team only. Log in to read the messages sent through the Contact page.</p>

        <%= form_with url: login_path, method: :post do %>
          <div class="mb-3">
            <%= label_tag :username, "Username", class: "form-label" %>
            <%= text_field_tag :username, params[:username], class: "form-control",
                               autocomplete: "username", autofocus: true %>
          </div>

          <%# Lab 3: password_toggle_controller.js shows or hides the password %>
          <div class="mb-4" data-controller="password-toggle">
            <%= label_tag :password, "Password", class: "form-label" %>
            <div class="input-group">
              <%= password_field_tag :password, nil, class: "form-control", autocomplete: "current-password",
                                     data: { password_toggle_target: "input" } %>
              <button type="button" class="btn btn-outline-secondary" data-action="password-toggle#toggle"
                      data-password-toggle-target="button">Show</button>
            </div>
          </div>

          <%= submit_tag "Log in", class: "btn btn-danger w-100" %>
        <% end %>
      </div>
    </div>
    <p class="text-center small text-muted mt-3">
      Looking for help? <%= link_to "See the hotlines", hotline_path %>.
    </p>
  </div>
</div>
